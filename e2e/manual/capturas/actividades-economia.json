[
  {
    "ficha": "clases",
    "nombre": "programar-clase",
    "ruta": "/clases/nueva",
    "preparacion": "Sede con al menos una actividad grupal publicada. Elegir la primera actividad en #clase-oferta para que aparezca el campo Box.",
    "pasos": [
      {
        "accion": "seleccionar",
        "selector": "#clase-oferta",
        "valor": ":ofertaGrupalId"
      },
      {
        "accion": "esperar",
        "selector": "#clase-capacidad"
      }
    ],
    "recorte": "form.tarjeta:has(#clase-oferta)",
    "marcas": [
      {
        "selector": "#clase-oferta",
        "numero": 2
      },
      {
        "selector": "#clase-inicio",
        "numero": 4
      },
      {
        "selector": "#clase-capacidad",
        "numero": 5
      },
      {
        "selector": "form.tarjeta:has(#clase-oferta) button[type=submit]",
        "numero": 6
      }
    ]
  },
  {
    "ficha": "clases",
    "nombre": "inscribir",
    "ruta": "/clases/:claseId",
    "preparacion": "Clase en estado PROGRAMADA con lugar. Escribir un apellido de ejemplo en #inscribir-persona y tocar la primera persona de .lista-personas para que aparezcan la casilla y el botón Inscribir.",
    "pasos": [
      {
        "accion": "escribir",
        "selector": "#inscribir-persona",
        "texto": ":personaApellido"
      },
      {
        "accion": "click",
        "selector": ".lista-personas button >> nth=0"
      },
      {
        "accion": "esperar",
        "selector": "section[aria-labelledby=\"titulo-inscribir\"] .acciones button"
      }
    ],
    "recorte": "section[aria-labelledby=\"titulo-inscribir\"]",
    "marcas": [
      {
        "selector": "section[aria-labelledby=\"titulo-inscribir\"] input[type=checkbox]",
        "numero": 4
      },
      {
        "selector": "section[aria-labelledby=\"titulo-inscribir\"] .acciones button",
        "numero": 5
      }
    ]
  },
  {
    "ficha": "asistencia",
    "nombre": "iniciar-clase",
    "ruta": "/asistencia/:claseHoyId",
    "preparacion": "Clase de hoy en estado PROGRAMADA con inscriptos.",
    "pasos": [
      {
        "accion": "esperar",
        "selector": "role=button[name=\"Iniciar clase\"]"
      }
    ],
    "recorte": "section.banda-asistencia",
    "marcas": [
      {
        "selector": "role=button[name=\"Iniciar clase\"]",
        "numero": 2
      }
    ]
  },
  {
    "ficha": "asistencia",
    "nombre": "tomar-lista",
    "ruta": "/asistencia/:claseEnCursoId",
    "preparacion": "Clase en estado EN_CURSO con al menos dos inscriptos con lugar y ninguno marcado. Marcar Presente en la primera fila para que aparezca Guardar asistencia habilitado.",
    "pasos": [
      {
        "accion": "click",
        "selector": "fieldset.marcas >> nth=0 >> label.opcion-radio--presente"
      },
      {
        "accion": "esperar",
        "selector": "role=button[name=/^Guardar asistencia/]"
      }
    ],
    "recorte": "section[aria-labelledby=\"titulo-participantes\"]",
    "marcas": [
      {
        "selector": "role=button[name=\"Marcar presentes a los sin marcar\"]",
        "numero": 2
      },
      {
        "selector": "fieldset.marcas >> nth=0",
        "numero": 3
      },
      {
        "selector": "role=button[name=/^Guardar asistencia/]",
        "numero": 4
      }
    ]
  },
