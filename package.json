{
  "name": "akine-web",
  "version": "0.0.1",
  "description": "AKINE frontend - SPA Angular para centros de kinesiologia, fisioterapia y rehabilitacion",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false && node scripts/check-coverage.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"e2e/**/*.ts\"",
    "api:generate": "openapi-generator-cli generate -i ../appKine-api/openapi/akine-api.yaml -g typescript-angular -o src/app/api/generated -c openapi-generator.json",
    "api:check": "node scripts/check-contract-version.mjs",
    "lint": "ng lint",
    "coverage:check": "node scripts/check-coverage.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
