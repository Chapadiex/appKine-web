{
  "name": "akine-web",
  "version": "0.0.1",
  "description": "AKINE frontend - SPA Angular para centros de kinesiologia, fisioterapia y rehabilitacion",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "node scripts/build-produccion.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false && node scripts/check-coverage.mjs && node scripts/check-contraste-medido.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "a11y:contraste": "playwright test --project=contraste-claro --project=contraste-oscuro",
    "a11y:movil": "playwright test --project=movil",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"e2e/**/*.ts\"",
    "api:generate": "openapi-generator-cli generate -i ../appKine-api/openapi/akine-api.yaml -g typescript-angular -o src/app/api/generated -c openapi-generator.json",
    "api:check": "node scripts/check-contract-version.mjs && node scripts/check-problem-types.mjs",
    "problems:check": "node scripts/check-problem-types.mjs",
    "lint": "ng lint && npm run lint:e2e",
    "lint:e2e": "tsc -p tsconfig.e2e.json && eslint e2e playwright.config.ts",
    "coverage:check": "node scripts/check-coverage.mjs",
    "contraste:check": "node scripts/check-contraste-medido.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "21.4.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.71.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "basic-ftp": "^6"
  }
}
