# --- Entorno de IA (local, personal de cada máquina) ---
.claude/qa-config.md
.claude/settings.local.json

# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Angular build ---
dist/
tmp/
out-tsc/
bazel-out/
.angular/

# --- Tests ---
coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# --- Secretos y entorno ---
.env
.env.*
!.env.example

# --- IDE ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.project
.classpath
.c9/
.history/

# --- SO ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Copias locales del catalogo de skills (Skill Hub, MCP) ---
.skill-hub/

# --- Impeccable (skill de diseño) ---
# El motor es un binario por plataforma: el lanzador lo baja una vez y lo verifica contra
# .claude/skills/impeccable/scripts/engine-checksums.txt. No se versiona.
.claude/skills/impeccable/scripts/bin/
.impeccable/config.local.json
# Estado del modo live (servidor, sesiones, anotaciones); su config.json sí se versiona.
.impeccable/live/*
!.impeccable/live/config.json
